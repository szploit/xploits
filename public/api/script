				while next(stillPending) and elapsed < 5 do
					task.wait(0.1)
					elapsed += 0.1
					for key, state in pairs(stillPending) do
						if _G.XploitsCFG[key] then
							pcall(function()
								_G.XploitsCFG[key].setState(state)
